-- Função para Atualizar Lista de Bosses Vivos
local function RefreshActiveBosses()
    local ActiveBosses = {}
    local Found = {}
    
    -- Verifica inimigos vivos no workspace
    if workspace:FindFirstChild("Enemies") then
        for _, enemy in pairs(workspace.Enemies:GetChildren()) do
            if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                -- Verifica se o inimigo está na nossa lista de Bosses do Sea atual
                if BossDB[CurrentSea] and table.find(BossDB[CurrentSea], enemy.Name) then
                    if not Found[enemy.Name] then
                        table.insert(ActiveBosses, enemy.Name)
                        Found[enemy.Name] = true
                    end
                end
            end
        end
    end
    
    table.sort(ActiveBosses)
    
    if #ActiveBosses == 0 then
        table.insert(ActiveBosses, "No Bosses Alive")
    end
    
    if _G.UIElements.SelectBoss then
        _G.UIElements.SelectBoss:SetValues(ActiveBosses)
        -- Seleciona o primeiro da lista se o atual não estiver mais vivo
        if _G.Settings.Main["Select Boss"] == "None" or not Found[_G.Settings.Main["Select Boss"]] then
            if ActiveBosses[1] ~= "No Bosses Alive" then
                _G.UIElements.SelectBoss:SetValue(ActiveBosses[1])
            else
                _G.UIElements.SelectBoss:SetValue("None")
            end
        end
    end
    
    return #ActiveBosses
end

