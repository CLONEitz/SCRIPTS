local function LoadExternalTable(url, name)
    local success, result = pcall(function()
        return loadstring(game:HttpGet(url))()
    end)
    
    if success and type(result) == "table" then
        warn("✅ " .. name .. " carregado com sucesso!")
        return result
    else
        warn("❌ Erro ao carregar " .. name .. ": " .. tostring(result))
        return nil
    end
end

