    local CurrentSea = detectSea(game.PlaceId)
    
    if QuestDB then
        local SeaQuests = QuestDB[CurrentSea]
        if SeaQuests then
            local bestLvl = -1
            local targetQuest = nil
            
            -- Itera por todas as quests do Sea atual para achar a melhor para o nível
            for lvl, data in pairs(SeaQuests) do
                if MyLevel >= lvl and lvl > bestLvl then
                    bestLvl = lvl
                    targetQuest = data
                end
            end
            
            if targetQuest then
                Mon = targetQuest[1]
                LevelQuest = targetQuest[2]
                NameQuest = targetQuest[3]
                CFrameQuest = targetQuest[4]
                CFrameMon = targetQuest[5]
            end
        end
    end
end

