local function ScanForFruits()
    if not _G.Settings.Fruits["Auto Scan"] then return end

    local found = 0
    for _, Obj in pairs(workspace:GetChildren()) do
        if Obj:IsA("Tool") and Obj:FindFirstChild("Handle") then
            local Mesh = Obj.Handle:FindFirstChildOfClass("SpecialMesh")
            local FruitName = "Fruit [Unknown]"
            
            if Mesh then
                for ID, Name in pairs(FruitDB) do
                    if string.find(tostring(Mesh.MeshId), ID) or (Mesh.TextureId and string.find(tostring(Mesh.TextureId), ID)) then
                        FruitName = Name
                        break
                    end
                end
            end
            
            if not FruitButtons[FruitName] then
                CreateFruitButton(FruitName, Obj.Handle.CFrame * CFrame.new(0, 3, 0))
                found = found + 1
            end
        end
    end
end

