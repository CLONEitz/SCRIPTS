                    mob.Humanoid.WalkSpeed = 0
                    mob.Humanoid.JumpPower = 0
                    
                    local dist = (mob.HumanoidRootPart.Position - playerCFrame.Position).Magnitude
                    local time = dist / 200 
                    
                    local angle = (i - 1) * (360 / #mobs)
                    
                    local offset = CFrame.Angles(0, math.rad(angle), 0) * CFrame.new(0, -2, safeplace)
                    local targetCF = CFrame.new(playerCFrame.Position.X, playerCFrame.Position.Y, playerCFrame.Position.Z) * offset
                    
                    TweenService:Create(
                        mob.HumanoidRootPart,
                        TweenInfo.new(time, Enum.EasingStyle.Linear),
                        {CFrame = targetCF}
                    ):Play()
                end)
            end
        end
    end

    local lastPlayerMove = 0
    local lockedPosition = nil

    while task.wait() do
        if not _G.Settings.Main["Auto Farm"] then 
            lockedPosition = nil
            continue 
        end

        pcall(function()
            if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then
                return
            end

            CheckQuest()

            if not LP.PlayerGui.Main.Quest.Visible then
                lockedPosition = nil
                topos(CFrameQuest)
                if (CFrameQuest.Position - LP.Character.HumanoidRootPart.Position).Magnitude <= 20 then
                    RS.Remotes.CommF_:InvokeServer("StartQuest", NameQuest, LevelQuest)
                    task.wait(1)
                end
            else
                CheckQuest()

                if workspace.Enemies:FindFirstChild(Mon) then
                    if not _G.CurrentMobGroup or not _G.MobGroupLocked then
                        lockedPosition = nil
                        local nearestMob = nil
                        local nearestDist = math.huge
                        
                        for _, mob in pairs(workspace.Enemies:GetChildren()) do
                            if mob.Name == Mon
                            and mob:FindFirstChild("HumanoidRootPart")
                            and mob:FindFirstChild("Humanoid")
                            and mob.Humanoid.Health > 0 then
                                local dist = (mob.HumanoidRootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude
                                if dist < nearestDist then
                                    nearestDist = dist
                                    nearestMob = mob
                                end
                            end
                        end
                        
                        local v = nearestMob
                        if v then
                            local potentialGroup = GetNearestMobs(
                                v.HumanoidRootPart.Position,
                                2, 
                                Mon,
                                near
                            )
                            
                            if #potentialGroup > 0 then
                                for _, mob in ipairs(potentialGroup) do
                                    if mob and mob.Parent and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                                        local loadCF = mob.HumanoidRootPart.CFrame * CFrame.new(0, 15, 0)
                                        if (LP.Character.HumanoidRootPart.Position - loadCF.Position).Magnitude > 10 then
                                            topos(loadCF)
                                            task.wait(0.2)
                                        end
                                        DamageUnit(mob)
                                    end
                                end
                                
                                _G.CurrentMobGroup = potentialGroup
                                _G.MobGroupLocked = true
                                
                                local targetCF = v.HumanoidRootPart.CFrame * CFrame.new(0, stay, 0)
                                lockedPosition = targetCF
                                if (LP.Character.HumanoidRootPart.Position - targetCF.Position).Magnitude > 10 then
                                    topos(targetCF)
                                    task.wait(0.2)
                                end
                                lastPlayerMove = tick()
                            end
                        end
                    end
                    
                    if _G.CurrentMobGroup and _G.MobGroupLocked and #_G.CurrentMobGroup > 0 then
                        repeat
                            task.wait()
                            if not _G.Settings.Main["Auto Farm"] then break end
                            if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then break end
                            
                            local primaryTarget = nil
                            for _, mob in ipairs(_G.CurrentMobGroup) do
                                if mob and mob.Parent and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                                    primaryTarget = mob
                                    break
                                end
                            end
                            
                            if not primaryTarget then break end

                            if lockedPosition then
                                local distance = (LP.Character.HumanoidRootPart.Position - lockedPosition.Position).Magnitude
                                if distance > 15 then
                                    LP.Character.HumanoidRootPart.CFrame = lockedPosition
                                end
                            end

                            if _G.Settings.Setting["Bring Mob"] then
                                BringMobsToPlayer(_G.CurrentMobGroup, LP.Character.HumanoidRootPart.CFrame)
                            end

                            for _, mob in ipairs(_G.CurrentMobGroup) do
                                if mob and mob.Parent and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                                    mob.HumanoidRootPart.CanCollide = false
                                    mob.HumanoidRootPart.Size = Vector3.new(50, 50, 50)
                                    DamageUnit(mob)
                                end
                            end

                            local aliveMobs = {}
                            for _, m in ipairs(_G.CurrentMobGroup) do
                                if m and m.Parent and m:FindFirstChild("Humanoid") and m.Humanoid.Health > 0 then
                                    table.insert(aliveMobs, m)
                                end
                            end
                            
                            if #aliveMobs > 0 then
                                _G.CurrentMobGroup = aliveMobs
                            else
                                _G.CurrentMobGroup = nil
                                _G.MobGroupLocked = false
                                lockedPosition = nil
                                break
                            end

                        until not _G.Settings.Main["Auto Farm"]

                        _G.CurrentMobGroup = nil
                        _G.MobGroupLocked = false
                        lockedPosition = nil
                    end
                else
                    _G.CurrentMobGroup = nil
                    _G.MobGroupLocked = false
                    lockedPosition = nil
                    topos(CFrameMon)
                end
            end
        end)
    end
end)

